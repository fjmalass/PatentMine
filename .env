# PATENTMINE CONFIGURATION WITH KEY INDIRECTIONS
#
PATENTMINE_CREDENTIALS_DIR=~/.ssh

# USPTO
PATENTMINE_USPTO_API_KEY=file:${PATENTMINE_CREDENTIALS_DIR}/uspto_odp_key

# Google Gemini API Key
GEMINI_API_KEY=file:${PATENTMINE_CREDENTIALS_DIR}/gemini_api_key

# OpenAI API Key
OPENAI_API_KEY=file:${PATENTMINE_CREDENTIALS_DIR}/openai_api_key

# Source mode controls provider selection for normal loads.
# One of: compare, uspto-first, uspto-only, google-only.
PATENTMINE_SOURCE_MODE=google-only

# BACKUP on BackBlaze
PATENTMINE_BACKUP_PROVIDER=b2
PATENTMINE_BACKUP_BUCKET=PatentMine
PATENTMINE_BACKUP_RCLONE_REMOTE=PatentMine
PATENTMINE_BACKUP_B2_KEY_ID=file:${PATENTMINE_CREDENTIALS_DIR}/patentmine/backblaze_b2_patentmine_key_id
PATENTMINE_BACKUP_B2_SECRET=file:${PATENTMINE_CREDENTIALS_DIR}/patentmine/backblaze_b2_patentmine_secret

# Default directory for document imports
PATENTMINE_IMPORT_FROM_DIR=./import_from

