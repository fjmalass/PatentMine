# PatentMine local environment.
# Copy to .env and fill in local-only values. Do not commit .env.

# Use USPTO ODP as the import source. Leave as google to avoid requiring a key.
PATENTMINE_IMPORT_SOURCE=uspto

# Paste the USPTO Open Data Portal API key here, or use USPTO_API_KEY_FILE.
USPTO_API_KEY=

# Optional alternative to USPTO_API_KEY.
# USPTO_API_KEY_FILE=~/.ssh/uspto_odp_key
